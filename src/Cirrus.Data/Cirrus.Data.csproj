<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <OutputPath>../../build/Cirrus.Data/$(Configuration)</OutputPath>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="SQL/**/*.sql" />
        <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Cirrus.Base\Cirrus.Base.csproj" />
        <ProjectReference Include="..\Cirrus.Models\Cirrus.Models.csproj" />
        <ProjectReference Include="..\Cirrus.SourceGenerators\Cirrus.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    </ItemGroup>
    
</Project>
