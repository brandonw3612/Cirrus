<local:CloudDriveViewBase
    x:Class="Cirrus.Views.CloudDriveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cirrus.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:Cirrus.Behaviors"
    xmlns:commanding="using:Cirrus.Commanding"
    xmlns:community="using:CommunityToolkit.WinUI"
    xmlns:controls="using:Cirrus.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:liveModels="using:Cirrus.LiveModels"
    mc:Ignorable="d">
    <Page.Resources>
        <commanding:ShowTrackContextFlyoutCommand x:Key="ShowTrackContextFlyoutCommand" />
        <commanding:PlayFromListCommand x:Key="PlayFromListCommand" />
        <animations:ImplicitAnimationSet x:Key="LayoutImplicitAnimations">
            <animations:OffsetAnimation Duration="0:0:0.400" />
            <animations:SizeAnimation Duration="0:0:0.400" />
            <animations:OpacityAnimation Duration="0:0:0.400" />
        </animations:ImplicitAnimationSet>
    </Page.Resources>
    <interactivity:Interaction.Behaviors>
        <behaviors:LoadedEventTriggerBehavior>
            <interactivity:InvokeCommandAction Command="{x:Bind LoadedCommand}" />
        </behaviors:LoadedEventTriggerBehavior>
        <behaviors:SizeChangedEventTriggerBehavior>
            <interactivity:InvokeCommandAction Command="{x:Bind SizeChangedCommand}" />
        </behaviors:SizeChangedEventTriggerBehavior>
    </interactivity:Interaction.Behaviors>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TracksVisibilityGroup">
                <VisualState x:Name="TracksVisible" />
                <VisualState x:Name="TracksCollapsed">
                    <VisualState.StateTriggers>
                        <community:IsNullOrEmptyStateTrigger Value="{x:Bind ViewModel.Tracks}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrackListView.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="HeaderLayoutStates">
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="ViewHeader.Height" Value="76" />
                        <Setter Target="ViewHeader.Padding" Value="16 0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="ViewHeader.Height" Value="152" />
                        <Setter Target="ViewHeader.Padding" Value="24 76 24 0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ProgressBar VerticalAlignment="Top" Canvas.ZIndex="2"
                     Background="Transparent"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Grid x:Name="ViewHeader"
              Background="Transparent"
              Canvas.ZIndex="1" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0 16" Height="76" Padding="16 0"
              animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderBackgroundBorder" Grid.ColumnSpan="3" Margin="-16 0"
                    animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}" />
            <TextBlock Grid.Column="0" x:Uid="Views/CloudDriveView/Header"
                       CharacterSpacing="-20" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"
                       animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}" />
            <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}"
                    Command="{StaticResource PlayFromListCommand}"
                    animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF5B0;" FontSize="12" />
                    <TextBlock x:Uid="Views/PlaylistDetailView/PlayAllButtonContent" />
                </StackPanel>
            </Button>
        </Grid>
        <ListView x:Name="TrackListView"
                  Style="{StaticResource TrackListViewStyle}"
                  SelectionMode="None"
                  Padding="16 108 16 88"
                  ItemsSource="{x:Bind ViewModel.Tracks}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="liveModels:IndexedOnlineTrack">
                    <controls:TrackListItem DataContext="{x:Bind Track}"
                                            Index="{x:Bind Index}"
                                            PlayFromListCommand="{StaticResource PlayFromListCommand}"
                                            ShowContextFlyoutCommand="{StaticResource ShowTrackContextFlyoutCommand}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:CloudDriveViewBase>