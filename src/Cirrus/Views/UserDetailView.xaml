<local:UserDetailViewBase
    x:Class="Cirrus.Views.UserDetailView"
    x:Name="CurrentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cirrus.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:Cirrus.Behaviors"
    xmlns:controls="using:Cirrus.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:liveModels="using:Cirrus.LiveModels"
    xmlns:modelPlaylist="using:Cirrus.Models.Business.Playlist"
    xmlns:modelUser="using:Cirrus.Models.Business.User"
    xmlns:themes="using:Cirrus.Themes"
    xmlns:community="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Page.Resources>
        <CollectionViewSource x:Name="PlaylistCollectionViewSource"
                              Source="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                              IsSourceGrouped="True" />
        <animations:ImplicitAnimationSet x:Key="LayoutImplicitAnimations">
            <animations:OffsetAnimation Duration="0:0:0.400" />
            <animations:SizeAnimation Duration="0:0:0.400" />
            <animations:OpacityAnimation Duration="0:0:0.400" />
        </animations:ImplicitAnimationSet>
    </Page.Resources>
    <interactivity:Interaction.Behaviors>
        <behaviors:LoadedEventTriggerBehavior>
            <interactivity:InvokeCommandAction Command="{x:Bind LoadedCommand}" />
        </behaviors:LoadedEventTriggerBehavior>
        <behaviors:SizeChangedEventTriggerBehavior>
            <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.SizeChangedCommand}" />
            <interactivity:InvokeCommandAction Command="{x:Bind SizeChangedCommand}" />
        </behaviors:SizeChangedEventTriggerBehavior>
    </interactivity:Interaction.Behaviors>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderLayoutStates">
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="ViewHeader.ColumnSpacing" Value="16" />
                        <Setter Target="ViewHeader.Padding" Value="16" />

                        <Setter Target="HeaderAvatarImage.Width" Value="200" />
                        <Setter Target="HeaderAvatarImage.Height" Value="200" />

                        <Setter Target="HeaderBackgroundBorder.Margin" Value="-16" />

                        <Setter Target="HeaderNicknameTextBlock.FontSize" Value="32" />

                        <Setter Target="HeaderExtendedInfoContainer.Visibility" Value="Visible" />

                        <Setter Target="HeaderActionButtons.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="ViewHeader.ColumnSpacing" Value="8" />
                        <Setter Target="ViewHeader.Padding" Value="16 244 16 16" />

                        <Setter Target="HeaderBackgroundBorder.Margin" Value="-8 -12" />

                        <Setter Target="HeaderAvatarImage.Width" Value="50" />
                        <Setter Target="HeaderAvatarImage.Height" Value="50" />

                        <Setter Target="HeaderNicknameTextBlock.FontSize" Value="24" />

                        <Setter Target="HeaderExtendedInfoContainer.Visibility" Value="Collapsed" />

                        <Setter Target="HeaderActionButtons.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ProgressBar VerticalAlignment="Top" Canvas.ZIndex="2"
                     Background="Transparent"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Grid x:Name="ViewHeader"
              Visibility="{x:Bind ViewModel.Profile, Converter={StaticResource EmptyObjectJudgeConverter}, Mode=OneWay}"
              Background="Transparent"
              Canvas.ZIndex="1" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="16" Padding="16" ColumnSpacing="16"
              animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderBackgroundBorder" Grid.ColumnSpan="3" Margin="-16"
                    animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}" />
            <controls:GlidyImage x:Name="HeaderAvatarImage"
                                 Grid.Column="0"
                                 Width="200" Height="200"
                                 VerticalAlignment="Center"
                                 ImageUriSource="{x:Bind ViewModel.Profile.AvatarImageUrl, Mode=OneWay, Converter={StaticResource NeteaseImageResizeConverter}, ConverterParameter=480}"
                                 animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}" />
            <StackPanel x:Name="InfoContainer"
                        Grid.Column="1"
                        VerticalAlignment="Center" Margin="0"
                        animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
                <TextBlock x:Name="HeaderNicknameTextBlock"
                           Text="{x:Bind ViewModel.Profile.Nickname, Mode=OneWay}"
                           FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="HeaderExtendedInfoContainer"
                            animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.4" />
                        <animations:TranslationAnimation From="0,8,0" To="0" Duration="0:0:0.4" />
                    </animations:Implicit.ShowAnimations>
                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation From="1" To="0" Duration="0:0:0.2" />
                    </animations:Implicit.HideAnimations>
                    <Button Style="{StaticResource TextBlockButtonStyle}" FontSize="16"
                            Padding="4 2" Margin="-4 8 -4 4"
                            Foreground="{ThemeResource SystemBaseMediumColor}"
                            Command="{x:Bind ViewModel.ShowDescriptionTeachingTipCommand}"
                            Visibility="{x:Bind ViewModel.Profile.Bio, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource EmptyObjectJudgeConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Profile.Bio, Mode=OneWay, Converter={StaticResource LineBreakRemovalConverter}}"
                            MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <StackPanel x:Name="SocialStatusPanel" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Left" Margin="-4 0">
                        <Button Style="{ThemeResource TextBlockButtonStyle}" Padding="4 2" CornerRadius="4">
                            <TextBlock>
                                <Run Text="{x:Bind ViewModel.Profile.FollowingCount, Mode=OneWay}" FontSize="18"
                                     Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" />
                                <Run x:Uid="Views/UserDetailView/Header/FollowingRun" FontSize="14"
                                     Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
                            </TextBlock>
                        </Button>
                        <Button Style="{ThemeResource TextBlockButtonStyle}" Padding="4 2" CornerRadius="4">
                            <TextBlock>
                                <Run Text="{x:Bind ViewModel.Profile.FollowerCount, Mode=OneWay}" FontSize="18"
                                     Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" />
                                <Run x:Uid="Views/UserDetailView/Header/FollowerRun" FontSize="14"
                                     Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <TeachingTip
                    IsOpen="{x:Bind ViewModel.IsDescriptionTeachingTipOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PreferredPlacement="Center" IsLightDismissEnabled="True">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Profile.Nickname, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="{x:Bind ViewModel.Profile.Bio, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </TeachingTip>
                <StackPanel x:Name="HeaderActionButtons"
            Grid.Column="1" Margin="-4 8 0 0" Orientation="Horizontal"
            animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
                    <StackPanel x:Name="AdditionalActionsContainer"
                Orientation="Horizontal"
                animations:Implicit.Animations="{StaticResource LayoutImplicitAnimations}">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.4" />
                            <animations:TranslationAnimation From="4,0,0" To="0" Duration="0:0:0.4" />
                        </animations:Implicit.ShowAnimations>
                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation From="1" To="0" Duration="0:0:0.2" />
                        </animations:Implicit.HideAnimations>
                        <Button Margin="4 0 0 0" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource CirrusIconSetFontFamily}"
                          Glyph="{StaticResource FontIconGlyphMoreHorizontalFilled}"
                          FontSize="16" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuFlyout.MenuFlyoutPresenterStyle>
                                        <Style TargetType="MenuFlyoutPresenter">
                                            <Setter Property="MinWidth" Value="250" />
                                        </Style>
                                    </MenuFlyout.MenuFlyoutPresenterStyle>
                                    <MenuFlyoutItem x:Uid="MenuFlyoutItems/Share"
                                    Icon="{community:FontIcon Glyph=&#xE72D;}"
                                    Command="{StaticResource ShareCommand}"
                                    CommandParameter="{x:Bind ViewModel.Profile, Mode=OneWay}" />
                                    <MenuFlyoutItem x:Uid="MenuFlyoutItems/CopyLink"
                                    Icon="{community:FontIcon Glyph=&#xE71B;}"
                                    Command="{StaticResource CopyLinkCommand}"
                                    CommandParameter="{x:Bind ViewModel.Profile, Mode=OneWay}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        <GridView x:Name="PlaylistGridView" ItemsSource="{x:Bind PlaylistCollectionViewSource.View, Mode=OneWay}"
                  Padding="16 256 16 80">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" AreStickyGroupHeadersEnabled="False" Margin="-8 0"
                                   ItemWidth="{Binding ElementName=CurrentView, Path=ViewModel.NavigatiableCardWidth, Mode=OneWay}" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="liveModels:NavigatiableGroup">
                            <TextBlock Text="{x:Bind GroupHeader}" Margin="8"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="24" FontWeight="SemiBold" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="Control">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Control">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplateSelector>
                <themes:UserPlaylistDataTemplateSelector>
                    <themes:UserPlaylistDataTemplateSelector.PlaybackRecordTemplate>
                        <DataTemplate x:DataType="modelUser:TopChart">
                            <controls:NavigatiableDisplayCard Image="ms-appx:///Assets/Images/PlaybackRecord.svg"
                                                              Title="{x:Bind Nickname, Converter={StaticResource LanguageResourceConverter}, ConverterParameter=Views/UserDetailView/PlaybackRecord/Title/Format}"
                                                              Subtitle="{x:Bind PlayedTrackCount, Converter={StaticResource LanguageResourceConverter}, ConverterParameter=Views/UserDetailView/PlaybackRecord/Subtitle/Format}"
                                                              DataContext="{Binding Mode=OneWay}" />
                        </DataTemplate>
                    </themes:UserPlaylistDataTemplateSelector.PlaybackRecordTemplate>
                    <themes:UserPlaylistDataTemplateSelector.PlaylistTemplate>
                        <DataTemplate x:DataType="modelPlaylist:OnlinePlaylist">
                            <controls:NavigatiableDisplayCard
                                Image="{x:Bind CoverImageUrl, Converter={StaticResource NeteaseImageResizeConverter}, ConverterParameter=400}"
                                Title="{x:Bind Title}"
                                Subtitle="{x:Bind TrackCount, Converter={StaticResource LanguageResourceConverter}, ConverterParameter=Views/UserDetailView/Playlist/Subtitle/Format}"
                                DataContext="{Binding Mode=OneWay}">
                                <Grid>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Padding="6 4"
                                            Margin="4" CornerRadius="4"
                                            Background="{ThemeResource AltColorAcrylicControlBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind Plays, Converter={StaticResource LargeNumberUnitConverter}}"
                                                FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </controls:NavigatiableDisplayCard>
                        </DataTemplate>
                    </themes:UserPlaylistDataTemplateSelector.PlaylistTemplate>
                </themes:UserPlaylistDataTemplateSelector>
            </GridView.ItemTemplateSelector>
        </GridView>
    </Grid>
</local:UserDetailViewBase>