<Page
    x:Class="Cirrus.Views.GcTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Margin="32" Spacing="16">
            <TextBlock
                x:Uid="Views/GcTestView/Header"
                Margin="16,0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <InfoBar
                x:Uid="Views/GcTestView/Warning"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="ForceGcButton"
                    x:Uid="Views/GcTestView/ForceGcButton"
                    Click="ForceGcButton_OnClick" />
                <Button
                    x:Name="TestLeaksButton"
                    x:Uid="Views/GcTestView/TestLeaksButton"
                    Click="TestLeaksButton_OnClick"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TestStatusTextBlock" VerticalAlignment="Center" />
            </StackPanel>
            <Border
                x:Name="LeakCheckHost"
                Height="500"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
